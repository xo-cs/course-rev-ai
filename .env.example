# Copy to .env.local and fill in. Read only on the server; never exposed to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated Gemini models tried after GEMINI_MODEL fails
GEMINI_FALLBACK_MODELS=
# Optional last-resort fallback (OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=
# Passcode for /admin (demo only, not real security)
ADMIN_PASSCODE=
